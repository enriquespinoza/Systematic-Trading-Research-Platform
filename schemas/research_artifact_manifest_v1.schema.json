{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research Artifact Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "engine_id",
    "source_repository",
    "source_commit",
    "data_as_of_utc",
    "available_at_utc",
    "generated_at_utc",
    "artifacts",
    "upstreams",
    "immutable"
  ],
  "properties": {
    "schema_version": {
      "const": "research-artifact-manifest-v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "engine_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "source_repository": {
      "type": "string",
      "pattern": "^enriquespinoza/[^/]+$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "data_as_of_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
    },
    "available_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "schema_id",
          "sha256",
          "byte_length"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "schema_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "byte_length": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "upstreams": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "engine_id",
          "run_id",
          "manifest_sha256",
          "available_at_utc"
        ],
        "properties": {
          "engine_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "run_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "available_at_utc": {
            "type": "string",
            "format": "date-time",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
          }
        }
      }
    },
    "immutable": {
      "const": true
    }
  }
}
